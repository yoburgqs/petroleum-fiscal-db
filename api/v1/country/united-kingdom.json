.pwc.com"},{"name":"EY_KPMG_CIT_Guide_2025","type":"practitioner_guide","n":3862,"url":"https://taxsummaries.pwc.com/allcountries"},{"name":"Finance Act 2011 Section 7 Ring Fence Corporation Tax 30 pct plus Supplementary Charge 10 pct UKCS","type":"legislation","n":3395,"url":"https://www.legislation.gov.uk/ukpga/2011/11/section/7"}]},"reform_history":[{"year":1975,"event":"Petroleum Revenue Tax introduced","take_change_pp":18.0,"take_change_label":"+18pp","direction":"hostile","notes":"PRT at 45% on field profits introduced alongside CIT, raising effective marginal rate from ~45% to ~63% following the 1973 oil shock. Marked a decisive shift toward government revenue capture.","source":"Petroleum Revenue Tax Act 1975 (UK); OGA/NSTA Annual Report","source_url":"https://www.legislation.gov.uk/ukpga/1975/22","confidence":"A"},{"year":1983,"event":"PRT reductions - Howe Budget stimulates North Sea investment","take_change_pp":null,"take_change_label":null,"direction":"friendly","notes":"Chancellor Howe reduced PRT from 75% to 70% and expanded development investment safeguard. Aimed at stimulating investment in smaller North Sea fields. UK fiscal regime temporarily more competitive vs Norway for marginal projects.","source":"UK Finance Act 1983; HMRC PRT guidance history; Wood Mackenzie North Sea fiscal review","source_url":null,"confidence":"B"},{"year":1993,"event":"Ring Fence Corporation Tax separated","take_change_pp":0.0,"take_change_label":null,"direction":"neutral","notes":"RFCT isolated UK upstream from other business losses, preserving a dedicated tax base. PRT base narrowed.","source":"Finance Act 1993, Part II; HMRC RFCT guidance","source_url":"https://www.legislation.gov.uk/ukpga/1993/34","confidence":"A"},{"year":2002,"event":"Ring Fence Expenditure Supplement introduced","take_change_pp":-3.0,"take_change_label":"-3pp","direction":"friendly","notes":"RFES: 10% uplift on unused exploration/development costs. Reduced effective take modestly.","source":"Finance Act 2002, s.92; HMRC guidance","source_url":"https://www.gov.uk/guidance/ring-fence-expenditure-supplement","confidence":"A"},{"year":2011,"event":"Supplementary Charge raised 20 to 32 percent","take_change_pp":7.0,"take_change_label":"+7pp","direction":"hostile","notes":"North Sea Supplementary Charge increased from 20% to 32% following high oil prices. Effective marginal rate rose to 81%.","source":"Finance Act 2011, s.7; HMRC North Sea Oil","source_url":"https://www.legislation.gov.uk/ukpga/2011/11","confidence":"A"},{"year":2016,"event":"Investment Allowances and decommissioning relief deeds","take_change_pp":null,"take_change_label":null,"direction":"friendly","notes":"UK replaced Supplementary Charge reduction with Investment Allowance and formalized Decommissioning Relief Deeds. IOCs received contractual certainty on decommissioning tax relief even if legislation changed. Encouraged late-life field investment.","source":"HMRC Investment Allowance guidance 2016; OGA Decommissioning Relief Deeds; Wood Review 2014 implementation","source_url":null,"confidence":"A"},{"year":2022,"event":"Energy Profits Levy introduced at 25 percent","take_change_pp":25.0,"take_change_label":"+25pp","direction":"hostile","notes":"EPL introduced May 2022 as windfall tax following Russia-Ukraine war. Investment allowance 80% of capex. Combined marginal rate reached 65%.","source":"Energy (Oil and Gas) Profits Levy Act 2022; HMRC EPL Technical Note","source_url":"https://www.legislation.gov.uk/ukpga/2022/40","confidence":"A"},{"year":2023,"event":"EPL rate raised to 35 percent; investment allowance cut","take_change_pp":10.0,"take_change_label":"+10pp","direction":"hostile","notes":"EPL rate increased from 25% to 35%. Investment allowance reduced from 80% to 29%. Combined marginal rate peaked at 75%.","source":"Finance (No.2) Act 2023; OBR Fiscal Risks Report 2023","source_url":"https://www.legislation.gov.uk/ukpga/2023/30","confidence":"A"},{"year":2024,"event":"EPL rate raised to